{
  "name": "heyama-objects-manager",
  "version": "1.0.0",
  "description": "Heyama Objects Manager - Full-stack application with NestJS, Next.js, MongoDB Atlas, Cloudinary, and Socket.io",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["heyama", "objects-manager", "nestjs", "nextjs", "mongodb", "cloudinary", "socketio"],
  "author": "Giovanni Larry",
  "license": "MIT"
}
