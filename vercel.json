{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "installCommand": "npm install",
    "framework": "nextjs",
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/next"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/_/backend/$1"
        }
    ],
    "env": {
        "NEXT_PUBLIC_API_URL": "@next_public_api_url"
    }
}
